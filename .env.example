# Supabase project URL, for example https://PROJECT_REF.supabase.co
VITE_SUPABASE_URL=

# Frontend-safe Supabase publishable key only. Never put service_role or secret keys here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Development-only local demo mode. Keep false for production and preview deployments.
VITE_DEMO_MODE=false
